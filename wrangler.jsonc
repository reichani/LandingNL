{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "landingnl",
  "main": "src/index.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "landingnl-db-staging",
      "database_id": "0bf83e5e-afe1-4fd1-ae16-dfd103d801da",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "400457048302-bks58p58mrf37cd5c52ifndr54shn8i1.apps.googleusercontent.com"
  },
  "env": {
    "staging": {
      "name": "landingnl-staging",
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "vars": {
        "GOOGLE_CLIENT_ID": "400457048302-bks58p58mrf37cd5c52ifndr54shn8i1.apps.googleusercontent.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "landingnl-db-staging",
          "database_id": "0bf83e5e-afe1-4fd1-ae16-dfd103d801da",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "landingnl",
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "vars": {
        "GOOGLE_CLIENT_ID": "400457048302-bks58p58mrf37cd5c52ifndr54shn8i1.apps.googleusercontent.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "landingnl-db",
          "database_id": "ba3aceec-0db5-4180-a665-0a440c76b18c",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
