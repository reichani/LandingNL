  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.14.7",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.1.6",
